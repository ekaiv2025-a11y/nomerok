# Скопируйте этот файл в .env.local (для компьютера) или впишите те же строки в Vercel → Settings → Environment Variables.

# Название сайта (показывается в логотипе, заголовках и текстах)
NEXT_PUBLIC_SITE_NAME=Nomerok

# Адрес сайта (для ссылок в Telegram и соцсетях)
NEXT_PUBLIC_SITE_URL=https://nomerok.ge

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=секретный-ключ-service_role

# Пароль для входа в /admin (минимум 8 символов, придумайте сложный)
ADMIN_PASSWORD=

# Telegram-бот для уведомлений о заявках
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Ваш ник в Telegram для связи (показывается внизу сайта), без @. Необязательно.
NEXT_PUBLIC_SUPPORT_TELEGRAM=

# Необязательно: дублировать уведомления на почту через сервис resend.com
# RESEND_API_KEY — ключ из resend.com → API Keys; NOTIFY_EMAIL — ваш email (тот, на который зарегистрирован Resend)
RESEND_API_KEY=
NOTIFY_EMAIL=

# Необязательно: имя бота без @ (иначе сайт узнает его сам)
# TELEGRAM_BOT_USERNAME=NomerokGeBot

# Автообновление базы при выкладке (Supabase → Connect → Session pooler → URI, с паролем базы)
DATABASE_URL=
